        {
            "label": "Run C# project (dotnet run)",
            "type": "shell",
            "command": "dotnet",
            "args": ["run"],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
              "echo": false,
              "reveal": "always",
              "focus": false,
              "panel": "shared",
              "showReuseMessage": false,
              "clear": true
            },
            "problemMatcher": []
